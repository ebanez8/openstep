<Window x:Class="OpenSteps.App.RecordingIndicatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenSteps recording"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        Focusable="False" IsHitTestVisible="False" SizeToContent="WidthAndHeight">
    <!--  Always dark, like the OS recording indicators, so it reads on any wallpaper or app.  -->
    <Border Margin="10"
            Background="#E8141820"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            CornerRadius="16"
            Padding="12,6,14,6">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="14" ShadowDepth="2" Opacity="0.35" />
        </Border.Effect>
        <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="Dot"
                     Width="10" Height="10"
                     Fill="#E0394A"
                     VerticalAlignment="Center"
                     Margin="0,0,8,0">
                <Ellipse.Triggers>
                    <EventTrigger RoutedEvent="Ellipse.Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="1.0" To="0.35"
                                                 Duration="0:0:0.9"
                                                 AutoReverse="True" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Ellipse.Triggers>
            </Ellipse>
            <TextBlock x:Name="StateText"
                       Text="REC"
                       Foreground="White"
                       FontWeight="SemiBold"
                       FontSize="12.5"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="DetailText"
                       Foreground="#D0D5DD"
                       FontSize="12.5"
                       Typography.NumeralAlignment="Tabular"
                       VerticalAlignment="Center"
                       Margin="8,0,0,0" />
            <TextBlock x:Name="HintText"
                       Foreground="#8A93A1"
                       FontSize="11.5"
                       VerticalAlignment="Center"
                       Margin="10,0,0,0" />
        </StackPanel>
    </Border>
</Window>
